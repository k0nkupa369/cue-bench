{
  "name": "cue-bench",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "start": "node src/retail/server.ts",
    "retail:run": "node src/retail/run.ts",
    "research:report": "node src/retail/findings.ts",
    "pages:build": "node retail/static/build.ts",
    "pages:check": "npm run pages:build && node retail/static/check.ts",
    "typecheck": "tsc --noEmit",
    "record": "node src/record.ts",
    "replay": "node src/replay.ts",
    "fixture": "node src/serve.ts",
    "agent": "node src/agent.ts",
    "demo": "node src/demo.ts",
    "report": "node src/report.ts",
    "pilot": "node src/agent.ts pilot normal",
    "test": "npm run typecheck && npm run demo && node src/retail/verify-publication.ts && node src/retail/navigation-experiment.ts verify && npm run research:report"
  },
  "dependencies": {
    "playwright": "^1.65.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "typescript": "^7.0.2"
  }
}
